    function populateDutyFormData(meeting) {
      currentDutyMeeting = meeting;
      const now = new Date();

      const docNumSeq = Math.floor(Math.random() * 40) + 10;
      document.getElementById('duty-doc-number').value = `${docNumSeq}/TB-TYT`;

      let issueDateStr = `${now.getDate()} tháng ${now.getMonth() + 1} năm ${now.getFullYear()}`;
      if (meeting.start && !isNaN(meeting.start.getTime())) {
        const leadDate = new Date(meeting.start.getTime() - (2 * 86400000));
        if (leadDate <= now) {
          issueDateStr = `${now.getDate()} tháng ${now.getMonth() + 1} năm ${now.getFullYear()}`;
        } else {
          issueDateStr = `${leadDate.getDate()} tháng ${leadDate.getMonth() + 1} năm ${leadDate.getFullYear()}`;
        }
      }
      document.getElementById('duty-doc-date').value = issueDateStr;

      let vVText = `V/v cử cán bộ tham gia tham dự ${meeting.topic}`;
      if (meeting.category === 'dihoc') {
        vVText = `V/v cử cán bộ y tế tham gia khóa đào tạo ${meeting.topic}`;
      }
      document.getElementById('duty-doc-subject').value = vVText;

      const basisDate = new Date(now.getTime() - (3 * 86400000));
      const basisDateStr = `${basisDate.getDate() < 10 ? '0' + basisDate.getDate() : basisDate.getDate()}/${basisDate.getMonth() + 1 < 10 ? '0' + (basisDate.getMonth() + 1) : (basisDate.getMonth() + 1)}/${basisDate.getFullYear()}`;
      const randomDocNum = Math.floor(Math.random() * 4000) + 1000;
      const organizer = meeting.organizer || 'Sở Y tế tỉnh Quảng Ngãi';
      document.getElementById('duty-doc-basis').value = `Căn cứ Công văn số ${randomDocNum}/SYT-NV ngày ${basisDateStr} của ${organizer} về việc mời tham dự ${meeting.topic}.`;

