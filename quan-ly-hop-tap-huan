    function handleSaveMeetingSubmit(e) {
      e.preventDefault();

      const editId = document.getElementById('form-meeting-id').value;
      const topic = document.getElementById('form-topic').value.trim();
      const location = document.getElementById('form-location').value.trim();
      let meetingLink = document.getElementById('form-meeting-link').value.trim();
      const organizer = document.getElementById('form-organizer').value.trim() || 'Sở Y tế / UBND';
      const status = document.getElementById('form-status').value;

      // Tự động trích xuất link nếu người dùng dán URL vào ô Địa điểm
      if (!meetingLink) {
        const urlMatch = location.match(/(https?:\/\/[^\s]+)/i);
        if (urlMatch) meetingLink = urlMatch[0];
      }

      let category = 'taphuan';
      const radios = document.getElementsByName('form-event-category');
      for (const r of radios) {
        if (r.checked) category = r.value;
      }

      const staff = formSelectedStaff.join(', ');

      if (!topic || !location || formSelectedStaff.length === 0) {
        showToast('Vui lòng điền đủ Tên chuyên đề, Cán bộ tham dự và Địa điểm!', 'warning');
        return;
      }

      let timeText = '';
      let startIso = '';
      let endIso = '';

      if (currentFormTimeMode === 'single') {
        const d = document.getElementById('form-single-date').value;
        if (!d) {
          showToast('Vui lòng chọn ngày diễn ra!', 'warning');
          return;
        }
        const sess = document.getElementById('form-single-session').value;
        const t = document.getElementById('form-single-custom-time').value || '08:00';
        const tPart = (sess === 'Cả ngày') ? 'Cả ngày' : t;

        timeText = `${getDayOfWeek(d)} (${fmtDateVN(d)}) - ${tPart}`;
        startIso = `${d}T${(sess === 'Cả ngày') ? '08:00:00' : (t + ':00')}`;
        endIso = `${d}T23:59:59`;
      } else {
        const d1 = document.getElementById('form-range-start').value;
        const d2 = document.getElementById('form-range-end').value;
        const note = document.getElementById('form-range-note').value.trim();

        if (!d1 || !d2) {
          showToast('Vui lòng chọn đủ Từ ngày và Đến ngày!', 'warning');
          return;
        }
        if (new Date(d1) > new Date(d2)) {
          showToast('Ngày bắt đầu không được sau ngày kết thúc!', 'warning');
          return;
        }

        timeText = `Từ ngày ${fmtDateVN(d1)} đến ${fmtDateVN(d2)}${note ? ` (${note})` : ''}`;
        startIso = `${d1}T07:30:00`;
        endIso = `${d2}T23:59:59`;
      }

      if (editId) {
        const target = meetingsList.find(m => m.tempId === editId);
        if (target) {
          target.category = category;
          target.topic = topic;
          target.staff = staff;
          target.location = location;
          target.meetingLink = meetingLink;
          target.organizer = organizer;
          target.status = status;
          target.time = timeText;
          target.startDate = startIso;
          target.endDate = endIso;
          showToast('Đã cập nhật lịch thành công!', 'success');
        }
      } else {
        const newMeeting = {
          tempId: `m_${Date.now()}`,
          category,
          topic,
          staff,
          location,
          meetingLink,
          organizer,
          status,
          time: timeText,
          startDate: startIso,
          endDate: endIso
        };
        meetingsList.unshift(newMeeting);
        showToast('Đã thêm lịch mới thành công!', 'success');
      }

      saveMeetingsToStorage();
      closeMeetingModal();
      processMeetingsData();
    }

