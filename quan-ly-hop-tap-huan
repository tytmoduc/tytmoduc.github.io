    function parseDateTime(item) {
      let start = null;
      let end = null;

      if (item.startDate) start = new Date(item.startDate);
      if (item.endDate) end = new Date(item.endDate);

      // Nếu không có ISO, bóc tách từ chuỗi hiển thị
      if (!start || isNaN(start.getTime())) {
        const matches = (item.time || '').match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/g);
        if (matches && matches.length > 0) {
          const p1 = matches[0].split('/');
          start = new Date(parseInt(p1[2], 10), parseInt(p1[1], 10) - 1, parseInt(p1[0], 10), 8, 0, 0);

          if (matches.length > 1) {
            const p2 = matches[1].split('/');
            end = new Date(parseInt(p2[2], 10), parseInt(p2[1], 10) - 1, parseInt(p2[0], 10), 17, 0, 0);
          } else {
            end = new Date(start.getTime());
            end.setHours(23, 59, 59);
          }
        }
      }

      if (!end || isNaN(end.getTime())) {
        if (start && !isNaN(start.getTime())) {
          end = new Date(start.getTime());
          end.setHours(23, 59, 59);
        } else {
          start = new Date(2099, 0, 1);
          end = new Date(2099, 0, 1);
        }
      }

      return { start, end };
    }

    function processMeetingsData() {
      const now = new Date();
      const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);

      const parsed = meetingsList.map((item, idx) => {
        const { start, end } = parseDateTime(item);
        
        // Hết hạn = Thời điểm kết thúc nhỏ hơn hiện tại
        const isExpired = end.getTime() < now.getTime();

        // Tính khoảng cách ngày so với hôm nay
        const diffMs = start.getTime() - todayStart.getTime();
        const diffDays = Math.floor(diffMs / (24 * 60 * 60 * 1000));

        // 5 CẤP ĐỘ MÀU KHẨN CẤP
        let level = 5;
        let levelBadge = '';
        let levelText = '';
        let colorTheme = {};

        if (isExpired) {
          level = 0;
        } else if (diffDays <= 0 && end.getTime() >= now.getTime()) {
          // CẤP 1: HÔM NAY / ĐANG DIỄN RA
          level = 1;
          levelBadge = 'bg-rose-600 text-white animate-pulse';
          levelText = diffDays < 0 ? '⚡ ĐANG DIỄN RA' : '🔴 HÔM NAY';
          colorTheme = {
            cardBorder: 'border-l-[6px] border-l-rose-600 border-rose-200 bg-gradient-to-r from-rose-50/80 to-white',
            badgeBg: 'bg-rose-100 text-rose-800 border border-rose-300',
            dateBox: 'bg-rose-600 text-white',
            tag: 'Hôm nay'
          };
        } else if (diffDays === 1 || diffDays === 2) {
          // CẤP 2: NGÀY MAI / CÒN 1-2 NGÀY
          level = 2;
          levelBadge = 'bg-amber-500 text-white';
          levelText = diffDays === 1 ? '🟠 NGÀY MAI' : '🟠 CÒN 2 NGÀY';
          colorTheme = {
            cardBorder: 'border-l-[6px] border-l-amber-500 border-amber-200 bg-gradient-to-r from-amber-50/70 to-white',
            badgeBg: 'bg-amber-100 text-amber-900 border border-amber-300',
            dateBox: 'bg-amber-500 text-white',
            tag: diffDays === 1 ? 'Ngày mai' : 'Còn 2 ngày'
          };
        } else if (diffDays <= 7) {
          // CẤP 3: TRONG TUẦN NÀY
          level = 3;
          levelBadge = 'bg-sky-600 text-white';
          levelText = `🔵 CÒN ${diffDays} NGÀY (Tuần này)`;
          colorTheme = {
            cardBorder: 'border-l-[6px] border-l-sky-500 border-sky-200 bg-gradient-to-r from-sky-50/60 to-white',
            badgeBg: 'bg-sky-100 text-sky-900 border border-sky-300',
            dateBox: 'bg-sky-600 text-white',
            tag: `Còn ${diffDays} ngày`
          };
        } else if (diffDays <= 14) {
          // CẤP 4: TUẦN TỚI
          level = 4;
          levelBadge = 'bg-teal-600 text-white';
          levelText = `🟢 CÒN ${diffDays} NGÀY (Tuần tới)`;
          colorTheme = {
            cardBorder: 'border-l-[6px] border-l-teal-500 border-teal-200 bg-gradient-to-r from-teal-50/50 to-white',
            badgeBg: 'bg-teal-100 text-teal-900 border border-teal-300',
            dateBox: 'bg-teal-600 text-white',
            tag: `Còn ${diffDays} ngày`
          };
        } else {
          // CẤP 5: TRÊN 2 TUẦN
          level = 5;
          levelBadge = 'bg-slate-500 text-white';
          levelText = `⚪ CÒN ${diffDays} NGÀY`;
          colorTheme = {
            cardBorder: 'border-l-[6px] border-l-slate-400 border-slate-200 bg-white',
            badgeBg: 'bg-slate-100 text-slate-700 border border-slate-300',
            dateBox: 'bg-slate-700 text-white',
            tag: `Còn ${diffDays} ngày`
          };
        }

        return {
          ...item,
          tempId: item.tempId || `m_${idx}_${Date.now()}`,
          category: item.category || 'taphuan',
          meetingLink: (item.meetingLink || '').trim(),
          start,
          end,
          diffDays,
          isExpired,
          level,
          levelBadge,
          levelText,
          colorTheme
        };
      });

      // TỰ ĐỘNG BỎ QUA NGÀY HẾT HẠN
      const activeUpcoming = parsed.filter(m => !m.isExpired);
      const archivedPast = parsed.filter(m => m.isExpired);

      // SẮP XẾP NGÀY GẦN NHẤT ĐẦU TIÊN
      activeUpcoming.sort((a, b) => a.start.getTime() - b.start.getTime());
      archivedPast.sort((a, b) => b.end.getTime() - a.end.getTime());

      window.__ACTIVE_MEETINGS = activeUpcoming;
      window.__ARCHIVED_MEETINGS = archivedPast;

      updateStatistics();
      renderMeetingsList();
      renderArchivedList();
      populateDutyDocDropdown();
    }

    function updateStatistics() {
      const active = window.__ACTIVE_MEETINGS || [];
      const archived = window.__ARCHIVED_MEETINGS || [];

      const todayCount = active.filter(m => m.diffDays <= 0).length;
      const tomorrowCount = active.filter(m => m.diffDays === 1 || m.diffDays === 2).length;
      const weekCount = active.filter(m => m.diffDays <= 7).length;

      document.getElementById('stat-count-today').innerText = todayCount;
      document.getElementById('stat-count-tomorrow').innerText = tomorrowCount;
      document.getElementById('stat-count-week').innerText = weekCount;
      document.getElementById('stat-count-total').innerText = active.length;
      document.getElementById('stat-hidden-past').innerText = `Đã ẩn ${archived.length} lịch cũ`;

      const diHocCount = active.filter(m => m.category === 'dihoc').length;
      const tapHuanCount = active.filter(m => m.category === 'taphuan').length;
      const hopCount = active.filter(m => m.category === 'hop').length;

      document.getElementById('count-cat-all').innerText = active.length;
      document.getElementById('count-cat-dihoc').innerText = diHocCount;
      document.getElementById('count-cat-taphuan').innerText = tapHuanCount;
      document.getElementById('count-cat-hop').innerText = hopCount;

      document.getElementById('count-archived-num').innerText = archived.length;
    }

