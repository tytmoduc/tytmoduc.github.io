    async function saveMeetingsToCloud() {
      if (!GOOGLE_SHEET_HOP_URL) {
        showToast("Vui lòng cấu hình URL Google Sheets trước!", "warning");
        return;
      }
      showLoading("Đang lưu lịch đi học & tập huấn lên Google Sheets...");
      try {
        const payload = {
          action: "saveMeetings",
          data: {
            records: meetingsList.map(m => {
              let mLink = (m.meetingLink || '').trim();
              if (!mLink && m.location) {
                const urlMatch = m.location.match(/(https?:\/\/[^\s]+)/i);
                if (urlMatch) mLink = urlMatch[0];
              }
              return {
                tempId: m.tempId || `m_${Date.now()}`,
                category: m.category || "taphuan",
                time: m.time || "",
                topic: m.topic || "",
                staff: m.staff || "",
                location: m.location || "",
                meetingLink: mLink,
                organizer: m.organizer || "",
                status: m.status || "Đã xếp lịch",
                startDate: m.startDate || "",
                endDate: m.endDate || ""
              };
            })
          }
        };
        const response = await fetch(GOOGLE_SHEET_HOP_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload)
        });
        const rawText = await response.text();
        let res;
        try {
          res = JSON.parse(rawText);
        } catch (jsonErr) {
          console.error("Phản hồi không phải JSON:", rawText);
          showToast("Đã gửi yêu cầu lưu lên Google Sheets!", "info");
          return;
        }

        if (res && res.status === "success") {
          showToast(res.message || "Đã lưu thành công lịch lên Google Sheets (bảo toàn cột Link)!", "success");
        } else {
          showToast("Lỗi lưu dữ liệu: " + (res.message || "Không xác định"), "error");
        }
      } catch (err) {
        console.error("Lỗi khi lưu lên Cloud:", err);
        showToast("Lỗi kết nối khi gửi dữ liệu lên Google Sheet.", "error");
      } finally {
        hideLoading();
      }
    }

    async function fetchMeetingsFromCloud(isAuto = false) {
      if (!GOOGLE_SHEET_HOP_URL) {
        if (!isAuto) showToast('Chưa cấu hình Web App URL. Đang dùng dữ liệu cục bộ.', 'info');
        return;
      }

      if (!isAuto) showLoading('Đang đồng bộ lịch từ Google Sheets...');
      try {
        const url = GOOGLE_SHEET_HOP_URL + (GOOGLE_SHEET_HOP_URL.includes('?') ? '&' : '?') + `action=load&t=${Date.now()}`;
        const response = await fetch(url, { method: 'GET', cache: 'no-store' });
        const res = await response.json();

        if (res.status === 'success' && res.data && res.data.length > 0) {
          meetingsList = res.data.map(item => ({
            ...item,
            tempId: item.tempId || `m_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`
          }));
          saveMeetingsToStorage(false);
          processMeetingsData();
          if (!isAuto) showToast(`Đã đồng bộ thành công ${meetingsList.length} lịch từ Google Sheets!`, 'success');
        } else {
          if (!isAuto) showToast('Không có dữ liệu mới trên Google Sheets.', 'info');
        }
      } catch (err) {
        console.warn('Lỗi kết nối Google Sheets:', err);
        if (!isAuto) showToast('Không thể kết nối đến Google Sheets. Đang dùng dữ liệu trên máy.', 'warning');
      } finally {
        if (!isAuto) hideLoading();
      }
    }

