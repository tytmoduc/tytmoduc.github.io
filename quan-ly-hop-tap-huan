        const t = document.getElementById('form-single-custom-time').value;
        if (d) {
          const tPart = (sess === 'Cả ngày') ? 'Cả ngày' : (t || sess);
          previewEl.innerText = `${getDayOfWeek(d)} (${fmtDateVN(d)}) - ${tPart}`;
        } else {
          previewEl.innerText = "Chưa chọn ngày diễn ra";
        }
      } else {
        const d1 = document.getElementById('form-range-start').value;
        const d2 = document.getElementById('form-range-end').value;
        const note = document.getElementById('form-range-note').value.trim();
        if (d1 && d2) {
          let text = `Từ ngày ${fmtDateVN(d1)} đến ${fmtDateVN(d2)}`;
          if (note) text += ` (${note})`;
          previewEl.innerText = text;
        } else {
          previewEl.innerText = "Vui lòng chọn Từ ngày & Đến ngày";
        }
      }
    }

