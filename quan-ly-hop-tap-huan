<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Quản Lý Lịch Đi Học, Đi Họp & Tập Huấn - TYT Mộ Đức</title>

  <!-- Tailwind CSS & SheetJS & FontAwesome & Google Fonts -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=Times+New+Roman&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #f8fafc;
    }
    
    .font-times {
      font-family: 'Times New Roman', Times, serif;
    }

    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    #loading-overlay { display: none; }
    .loader {
      border: 4px solid #f1f5f9; border-top: 4px solid #d97706;
      border-radius: 50%; width: 42px; height: 42px;
      animation: spin 1s linear infinite;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    .a4-simulation-sheet {
      width: 210mm;
      min-height: 297mm;
      padding: 20mm 15mm 20mm 25mm; /* Chuẩn NĐ 30: Trái 25mm, phải 15mm, trên 20mm, dưới 20mm */
      margin: 0 auto;
      background: white;
      box-shadow: 0 10px 30px -10px rgba(0,0,0,0.15), 0 4px 6px -2px rgba(0,0,0,0.05);
      box-sizing: border-box;
      position: relative;
    }

    .editable-active [contenteditable="true"] {
      outline: 1.5px dashed #0284c7;
      background-color: #f0f9ff;
      border-radius: 3px;
      padding: 1px 3px;
    }

    @media print {
      body {
        background-color: white !important;
        margin: 0 !important;
        padding: 0 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      
      body.print-schedule-mode > *:not(#print-container) { display: none !important; }
      body.print-assignment-mode > *:not(#print-assignment-container) { display: none !important; }

      #print-container {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        font-family: 'Times New Roman', Times, serif;
        color: black;
      }

      #print-assignment-container {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        font-family: 'Times New Roman', Times, serif;
        color: black;
        line-height: 1.45;
      }

      #print-container table {
        page-break-inside: auto;
        border-collapse: collapse !important;
        width: 100% !important;
        table-layout: fixed !important;
      }
      
      #print-container tr {
        page-break-inside: avoid;
        page-break-after: auto;
      }
      
      #print-container thead {
        display: table-header-group;
      }
      
      #print-container th, #print-container td {
        border: 0.5pt solid black !important;
        padding: 4px 3px !important;
        vertical-align: middle !important;
        font-size: 8pt !important;
      }
    }
    #print-container { display: none; }
    #print-assignment-container { display: none; }
  </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col bg-slate-50 antialiased selection:bg-amber-100 selection:text-amber-900">

  <!-- OVERLAY LOADING -->
  <div id="loading-overlay" class="fixed inset-0 bg-white/85 backdrop-blur-sm z-50 flex flex-col items-center justify-center">
    <div class="loader mb-4"></div>
    <p class="text-amber-700 font-bold text-base" id="loading-text">Đang đồng bộ lịch đi học & tập huấn...</p>
  </div>

  <!-- TOAST THÔNG BÁO -->
  <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <header class="flex-none p-3 md:p-5 pb-2">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 mb-3 flex flex-col md:flex-row justify-between items-center gap-3 border-l-4 border-l-amber-600">
      
      <!-- Thông tin đơn vị & Tiêu đề -->
      <div class="flex items-center gap-3">
        <a href="index.html" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-amber-50 text-slate-600 hover:text-amber-700 flex items-center justify-center transition" title="Về trang chủ">
          <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-lg sm:text-xl md:text-2xl font-black text-slate-800 tracking-tight flex items-center">
              <i class="fa-solid fa-graduation-cap text-amber-600 mr-2"></i>Quản Lý Lịch Đi Học, Đi Họp & Tập Huấn
            </h1>
            <span class="bg-amber-50 text-amber-800 text-[11px] px-2.5 py-0.5 rounded-full font-bold border border-amber-200">TYT Xã Mộ Đức</span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Sắp xếp theo cấp độ màu khẩn cấp • Tự động ẩn lịch cũ • Xuất văn bản Phân công nhiệm vụ A4 chuẩn NĐ 30/2020</p>
        </div>
      </div>

      <!-- CÁC NÚT HÀNH ĐỘNG CHÍNH -->
      <div class="flex flex-wrap gap-2 justify-end items-center">
        
        <!-- Nút chuyển chế độ xem: Danh Sách <-> Văn Bản A4 -->
        <div class="bg-slate-100 p-1 rounded-xl flex items-center gap-1 border border-slate-200 shadow-xs">
          <button id="tab-btn-cards" onclick="switchMainTab('cards')" class="px-3 py-1.5 rounded-lg text-xs font-bold transition bg-white text-slate-800 shadow-xs flex items-center gap-1.5">
            <i class="fa-solid fa-calendar-days text-amber-600"></i>
            <span>Lịch Sắp Tới</span>
          </button>
          <button id="tab-btn-doc" onclick="switchMainTab('doc')" class="px-3 py-1.5 rounded-lg text-xs font-bold transition text-slate-600 hover:text-slate-900 flex items-center gap-1.5">
            <i class="fa-solid fa-file-contract text-sky-600"></i>
            <span>Văn Bản Phân Công A4</span>
          </button>
        </div>

        <button onclick="openMeetingModal()" class="px-3.5 py-2 bg-amber-600 text-white font-bold rounded-xl hover:bg-amber-700 transition text-xs flex items-center gap-1.5 shadow-sm shadow-amber-600/30">
          <i class="fa-solid fa-plus"></i> Thêm Lịch Mới
        </button>

        <button onclick="openDutyAssignmentModal()" class="px-3 py-2 bg-amber-50 text-amber-800 border border-amber-300 font-bold rounded-xl hover:bg-amber-100 transition text-xs flex items-center gap-1.5 shadow-sm" title="Tạo văn bản phân công nhiệm vụ cử cán bộ đi học / tập huấn">
          <i class="fa-solid fa-file-signature text-amber-700"></i> Soạn Phân Công
        </button>

        <button onclick="exportToExcel()" class="px-3 py-2 bg-green-50 text-green-700 border border-green-200 font-bold rounded-xl hover:bg-green-100 transition text-xs flex items-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-file-excel"></i> Xuất Excel
        </button>

        <button onclick="printMeetingSchedule()" class="px-3 py-2 bg-rose-50 text-rose-700 border border-rose-200 font-bold rounded-xl hover:bg-rose-100 transition text-xs flex items-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-print"></i> In Bảng Lịch
        </button>

        <button onclick="saveMeetingsToCloud()" class="px-3.5 py-2 bg-emerald-600 text-white font-bold rounded-xl hover:bg-emerald-700 transition text-xs flex items-center gap-1.5 shadow-sm shadow-emerald-600/30" title="Lưu và đồng bộ lịch lên Google Sheets">
          <i class="fa-solid fa-cloud-arrow-up"></i> Lưu Cloud
        </button>

        <button onclick="openApiConfigModal()" class="px-3 py-2 bg-slate-100 text-slate-700 border border-slate-200 font-bold rounded-xl hover:bg-slate-200 transition text-xs flex items-center gap-1.5 shadow-sm" title="Cấu hình Google Sheets Apps Script API">
          <i class="fa-solid fa-gear"></i> Cấu Hình Cloud
        </button>

        <button onclick="fetchMeetingsFromCloud()" class="px-3 py-2 bg-amber-50 text-amber-700 border border-amber-200 font-bold rounded-xl hover:bg-amber-100 transition text-xs flex items-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-rotate text-amber-600"></i> Tải lại
        </button>
      </div>
    </div>

    <!-- THẺ THỐNG KÊ NHANH 4 CHỈ SỐ -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-2.5">
      
      <div class="bg-white p-3 rounded-2xl border border-rose-200 bg-gradient-to-r from-rose-50/70 to-white shadow-xs flex items-center justify-between">
        <div>
          <div class="text-[10.5px] font-bold text-rose-600 uppercase tracking-wide">Hôm Nay / Đang Diễn Ra</div>
          <div class="text-xl font-black text-rose-700 mt-0.5" id="stat-count-today">0</div>
          <div class="text-[10px] text-rose-500 font-semibold">Cần cử cán bộ tham dự ngay</div>
        </div>
        <div class="w-9 h-9 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-sm font-bold">
          <i class="fa-solid fa-bell animate-bounce"></i>
        </div>
      </div>

      <div class="bg-white p-3 rounded-2xl border border-amber-200 bg-gradient-to-r from-amber-50/70 to-white shadow-xs flex items-center justify-between">
        <div>
          <div class="text-[10.5px] font-bold text-amber-700 uppercase tracking-wide">Ngày Mai / 1-2 Ngày Tới</div>
          <div class="text-xl font-black text-amber-800 mt-0.5" id="stat-count-tomorrow">0</div>
          <div class="text-[10px] text-amber-600 font-semibold">Chuẩn bị hồ sơ, phân công</div>
        </div>
        <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-sm font-bold">
          <i class="fa-solid fa-clock"></i>
        </div>
      </div>

      <div class="bg-white p-3 rounded-2xl border border-sky-200 bg-gradient-to-r from-sky-50/70 to-white shadow-xs flex items-center justify-between">
        <div>
          <div class="text-[10.5px] font-bold text-sky-700 uppercase tracking-wide">Trong Tuần Này</div>
          <div class="text-xl font-black text-sky-800 mt-0.5" id="stat-count-week">0</div>
          <div class="text-[10px] text-sky-600 font-semibold">Kế hoạch công tác tuần</div>
        </div>
        <div class="w-9 h-9 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center text-sm font-bold">
          <i class="fa-solid fa-calendar-week"></i>
        </div>
      </div>

      <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
        <div>
          <div class="text-[10.5px] font-bold text-slate-500 uppercase tracking-wide">Tổng Lịch Sắp Tới</div>
          <div class="text-xl font-black text-slate-800 mt-0.5" id="stat-count-total">0</div>
          <div class="text-[10px] text-emerald-600 font-semibold" id="stat-hidden-past">Đã tự động ẩn lịch cũ</div>
        </div>
        <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center text-sm font-bold">
          <i class="fa-solid fa-calendar-check"></i>
        </div>
      </div>

    </div>

    <!-- BỘ LỌC DANH MỤC & THỜI GIAN & Ô TÌM KIẾM -->
    <div class="flex flex-col lg:flex-row justify-between items-stretch lg:items-center gap-2 mb-1">
      
      <div class="flex flex-wrap items-center gap-1.5">
        
        <!-- Lọc theo loại hình: Tất cả | Đi học | Tập huấn | Cuộc họp -->
        <div class="flex items-center gap-1 bg-white p-1 rounded-xl border border-slate-200 shadow-xs overflow-x-auto custom-scrollbar">
          <button onclick="filterByCategory('all')" id="btn-cat-all" class="px-2.5 py-1 rounded-lg text-xs font-bold transition bg-amber-600 text-white shadow-xs whitespace-nowrap">
            Tất cả (<span id="count-cat-all">0</span>)
          </button>
          <button onclick="filterByCategory('dihoc')" id="btn-cat-dihoc" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition whitespace-nowrap flex items-center gap-1">
            <i class="fa-solid fa-book-open-reader text-indigo-600"></i> Đi Học / Đào Tạo (<span id="count-cat-dihoc">0</span>)
          </button>
          <button onclick="filterByCategory('taphuan')" id="btn-cat-taphuan" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition whitespace-nowrap flex items-center gap-1">
            <i class="fa-solid fa-chalkboard-user text-amber-600"></i> Tập Huấn (<span id="count-cat-taphuan">0</span>)
          </button>
          <button onclick="filterByCategory('hop')" id="btn-cat-hop" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition whitespace-nowrap flex items-center gap-1">
            <i class="fa-solid fa-users text-teal-600"></i> Họp / Giao Ban (<span id="count-cat-hop">0</span>)
          </button>
        </div>

        <!-- Lọc theo thời gian -->
        <div class="flex items-center gap-1 bg-white p-1 rounded-xl border border-slate-200 shadow-xs">
          <button onclick="filterByTime('all')" id="btn-time-all" class="px-2 py-1 rounded-lg text-xs font-bold bg-slate-700 text-white transition">Tất cả thời gian</button>
          <button onclick="filterByTime('urgent')" id="btn-time-urgent" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition">Hôm nay / Ngày mai</button>
          <button onclick="filterByTime('week')" id="btn-time-week" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition">Trong tuần này</button>
          <button onclick="filterByTime('month')" id="btn-time-month" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition">Trong tháng</button>
        </div>

      </div>

      <!-- Ô tìm kiếm lịch -->
      <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-xs flex-1 lg:max-w-xs">
        <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs"></i>
        <input type="text" id="search-meeting-input" placeholder="Tìm nội dung, cán bộ, địa điểm..." class="w-full bg-transparent border-none outline-none text-xs text-slate-700 focus:ring-0" onkeyup="renderMeetingsList()">
      </div>

    </div>
  </header>

  <!-- NỘI DUNG CHÍNH (GỒM 2 TAB: DANH SÁCH LỊCH & VĂN BẢN A4) -->
  <main class="flex-1 overflow-hidden p-3 md:p-5 pt-0 flex flex-col">
    
    <!-- TAB 1: DANH SÁCH LỊCH SẮP TỚI (CẤP ĐỘ MÀU GIẢM DẦN) -->
    <div id="view-tab-cards" class="flex-1 flex flex-col overflow-hidden space-y-3">
      
      <!-- Khung danh sách thẻ lịch -->
      <div class="flex-1 overflow-y-auto custom-scrollbar pr-1 space-y-2.5" id="meetings-list-container">
        <!-- Render sống động qua JS -->
      </div>

      <!-- Khu vực lịch sử đã qua (Tự động ẩn) -->
      <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-xs flex flex-col sm:flex-row justify-between items-center gap-2 text-xs">
        <div class="text-slate-500 font-medium flex items-center gap-1.5">
          <i class="fa-solid fa-shield-halved text-emerald-600"></i>
          <span>Các sự kiện đã hết hạn được tự động loại bỏ để bạn không bị nhầm lẫn.</span>
        </div>
        <button onclick="toggleArchivedMeetings()" id="btn-toggle-archive" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold transition flex items-center gap-1.5">
          <i class="fa-solid fa-clock-rotate-left text-slate-500"></i>
          <span>Xem lịch sử đã qua (<span id="count-archived-num">0</span>)</span>
        </button>
      </div>

      <!-- Danh sách lịch đã kết thúc (Mặc định ẩn) -->
      <div id="archived-meetings-container" class="hidden max-h-48 overflow-y-auto custom-scrollbar space-y-2 p-3 bg-slate-100 rounded-2xl border border-slate-200 text-xs">
        <!-- Render qua JS khi người dùng cần xem -->
      </div>
    </div>

    <!-- TAB 2: SOẠN & XEM TRƯỚC VĂN BẢN PHÂN CÔNG NHIỆM VỤ A4 TRỰC DIỆN -->
    <div id="view-tab-doc" class="hidden flex-1 overflow-y-auto custom-scrollbar p-2 sm:p-4 bg-slate-200/80 rounded-2xl border border-slate-300 flex flex-col items-center justify-start space-y-4">
      
      <!-- Thanh công cụ nổi phía trên bản in A4 -->
      <div class="w-full max-w-4xl bg-slate-900 text-white p-3 rounded-2xl shadow-lg flex flex-wrap items-center justify-between gap-3 sticky top-0 z-30">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-bold">
            <i class="fa-solid fa-file-contract"></i>
          </span>
          <div>
            <div class="font-extrabold text-sm flex items-center gap-2">
              <span>Văn Bản Phân Công Nhiệm Vụ (Khổ A4)</span>
              <span class="bg-amber-400/20 text-amber-300 border border-amber-400/30 text-[10px] px-2 py-0.2 rounded-full font-bold">NĐ 30/2020/NĐ-CP</span>
            </div>
            <div class="text-[11px] text-slate-400">Chọn lịch nguồn bên dưới để tự động tạo mẫu văn bản cử cán bộ</div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <!-- Chọn nhanh lịch họp nguồn -->
          <select id="direct-doc-source-select" onchange="onDirectDocSourceChange(this.value)" class="bg-slate-800 text-slate-200 border border-slate-700 text-xs font-bold rounded-xl px-2.5 py-1.5 outline-none hover:bg-slate-700 cursor-pointer max-w-xs truncate">
            <!-- Điền động qua JS -->
          </select>

          <!-- Bật tắt sửa trực tiếp -->
          <button id="btn-direct-edit" onclick="toggleDirectEditMode()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
            <i class="fa-solid fa-pen-to-square text-sky-400"></i>
            <span id="btn-direct-edit-label">Chỉnh sửa trực tiếp</span>
          </button>

          <!-- Tải Word -->
          <button onclick="downloadDirectWordDoc()" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-500 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-sm shadow-blue-600/30">
            <i class="fa-solid fa-file-word"></i>
            <span>Tải File Word (.doc)</span>
          </button>

          <!-- In / Xuất PDF -->
          <button onclick="printDirectDoc()" class="px-3.5 py-1.5 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-sm shadow-amber-600/30">
            <i class="fa-solid fa-print"></i>
            <span>In / Xuất PDF A4</span>
          </button>
        </div>
      </div>

      <!-- TỜ GIẤY A4 TRỰC DIỆN (ĐÚNG TỈ LỆ 210mm x 297mm) -->
      <article id="direct-a4-paper" class="a4-simulation-sheet font-times text-black text-[13pt] leading-[1.4] select-text">
        <!-- Render sống động qua JS -->
      </article>

    </div>

  </main>

  <!-- MODAL THÊM / SỬA LỊCH ĐI HỌC & TẬP HUẤN -->
  <div id="meeting-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-3 overflow-y-auto">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl border border-slate-200 overflow-hidden transform transition-all my-auto">
      
      <!-- Header Modal -->
      <div class="p-4 bg-slate-900 text-white flex justify-between items-center">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-bold">
            <i class="fa-solid fa-calendar-plus"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-sm sm:text-base leading-tight" id="meeting-modal-title">Thêm Lịch Đi Học / Tập Huấn Mới</h3>
            <p class="text-[11px] text-slate-400">Thiết lập thời gian, chọn cán bộ từ danh bạ 4 điểm trạm và đơn vị tổ chức</p>
          </div>
        </div>
        <button onclick="closeMeetingModal()" class="w-7 h-7 rounded-lg hover:bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center transition">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Form nhập liệu -->
      <form onsubmit="handleSaveMeetingSubmit(event)" class="p-4 sm:p-5 space-y-3 text-xs max-h-[80vh] overflow-y-auto custom-scrollbar">
        <input type="hidden" id="form-meeting-id">

        <!-- Chọn loại hình sự kiện -->
        <div>
          <label class="block font-bold text-slate-700 mb-1">Loại hình sự kiện: <span class="text-rose-500">*</span></label>
          <div class="grid grid-cols-3 gap-2">
