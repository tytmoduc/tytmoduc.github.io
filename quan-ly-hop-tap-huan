    function fmtDateVN(iso) {
      if (!iso) return '';
      const p = iso.split('-');
      return p.length === 3 ? `${p[2]}/${p[1]}/${p[0]}` : iso;
    }

    function getDayOfWeek(iso) {
      if (!iso) return '';
      const d = new Date(iso);
      const days = ['Chủ Nhật', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];
      return days[d.getDay()] || '';
    }

