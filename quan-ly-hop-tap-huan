    function renderStaffDirectoryItems() {
      const container = document.getElementById('staff-directory-list-container');
      const search = (document.getElementById('staff-search-input')?.value || '').toLowerCase().trim();
      const staffList = getLiveStaffList();

      const filtered = staffList.filter(s => 
        s.name.toLowerCase().includes(search) || 
        (s.shortName && s.shortName.toLowerCase().includes(search)) ||
        (s.point && s.point.toLowerCase().includes(search))
      );

      const groups = {};
      filtered.forEach(s => {
        if (!groups[s.point]) groups[s.point] = [];
        groups[s.point].push(s);
      });

      let html = '';
      for (const pt in groups) {
        html += `
