        { id: 'btn-prio-urgent', p: 'urgent' },
        { id: 'btn-prio-normal', p: 'normal' },
        { id: 'btn-prio-followup', p: 'followup' }
      ];
      btns.forEach(b => {
        const el = document.getElementById(b.id);
        if (b.p === prio) {
          el.className = "px-2.5 py-1 rounded-lg text-xs font-bold transition bg-sky-600 text-white shadow-xs whitespace-nowrap";
