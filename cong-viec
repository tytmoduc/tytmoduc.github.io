      `).join('');
    }

    function toggleArchivedTasks() {
      const box = document.getElementById('archived-tasks-container');
      const btn = document.getElementById('btn-toggle-archive');
      const isHidden = box.classList.contains('hidden');

      if (isHidden) {
        box.classList.remove('hidden');
        btn.innerHTML = `<i class="fa-solid fa-chevron-up"></i> <span>Ẩn kho lưu trữ</span>`;
      } else {
        box.classList.add('hidden');
        const count = (window.__ARCHIVED_TASKS || []).length;
        btn.innerHTML = `<i class="fa-solid fa-clock-rotate-left"></i> <span>Xem việc đã kết thúc / hết hạn (${count})</span>`;
      }
    }

