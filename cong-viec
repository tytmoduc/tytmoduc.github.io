      const select = document.getElementById('personal-staff-select');
      if (!select) return;

      const staffList = getLiveStaffList();
      const groups = {};
      staffList.forEach(s => {
        if (!groups[s.point]) groups[s.point] = [];
        groups[s.point].push(s);
      });

      let html = '<option value="all">-- Xem tất cả cán bộ --</option>';
      for (const pt in groups) {
        html += `<optgroup label="${pt}">`;
        groups[pt].forEach(stf => {
          html += `<option value="${stf.name}">${stf.name} (${stf.shortName || ''})</option>`;
        });
        html += '</optgroup>';
      }
      select.innerHTML = html;
