    function printCurrentAssignmentDoc() {
      if (!activePreviewTask) return;
      const printContainer = document.getElementById('print-assignment-container');
      printContainer.innerHTML = buildAssignmentDocHtml(activePreviewTask);

      let styleEl = document.getElementById('dynamic-print-page-style');
      if (!styleEl) {
        styleEl = document.createElement('style');
        styleEl.id = 'dynamic-print-page-style';
        document.head.appendChild(styleEl);
      }
      styleEl.innerHTML = `@media print { @page { size: A4 portrait; margin: 18mm 15mm 18mm 20mm; } }`;

      setTimeout(() => {
        window.print();
      }, 300);
    }

    function downloadCurrentWordDoc() {
      if (!activePreviewTask) return;
      const t = activePreviewTask;
      const titleSafe = t.title.replace(/[^a-zA-Z0-9\p{L}]/gu, '_').slice(0, 35);
      const innerHtml = buildAssignmentDocHtml(t);

      const docContent = `
        <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
        <head>
          <meta charset='utf-8'>
          <title>Phieu_giao_viec_${titleSafe}</title>
          <style>
            @page {
              size: 21.0cm 29.7cm;
              margin: 2.0cm 1.5cm 2.0cm 2.5cm;
              mso-page-orientation: portrait;
            }
            body {
              font-family: 'Times New Roman', Times, serif;
              font-size: 13pt;
              line-height: 1.4;
              color: #000000;
            }
            table { border-collapse: collapse; width: 100%; }
            td { vertical-align: top; }
            p { margin-top: 0; margin-bottom: 6pt; text-align: justify; }
          </style>
        </head>
        <body>
          ${innerHtml}
        </body>
        </html>
      `;

      const blob = new Blob(['\ufeff', docContent], { type: 'application/msword;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Phieu_giao_viec_${titleSafe}.doc`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      showToast('Đã tải file Word (.doc) Phiếu giao việc!', 'success');
    }

    function copyCurrentDocText() {
      const paperEl = document.getElementById('modal-a4-paper');
      if (!paperEl) return;

      const range = document.createRange();
      range.selectNode(paperEl);
      window.getSelection().removeAllRanges();
      window.getSelection().addRange(range);

      try {
        const successful = document.execCommand('copy');
        if (successful) {
          showToast('Đã sao chép nội dung văn bản vào Clipboard!', 'success');
        } else {
          showToast('Vui lòng dùng Ctrl+C để sao chép', 'warning');
        }
      } catch (err) {
        showToast('Trình duyệt không hỗ trợ lệnh sao chép tự động', 'error');
      }
      window.getSelection().removeAllRanges();
    }

    function downloadTaskICS(tempId) {
      const allTasks = [...(window.__ACTIVE_TASKS || []), ...(window.__ARCHIVED_TASKS || [])];
      const t = allTasks.find(x => x.tempId === tempId);
      if (!t) return;

      const deadline = t.deadline || new Date();
      const formatICSDate = (d) => {
        return d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';
      };

      const dtEnd = formatICSDate(deadline);
      const dtStart = formatICSDate(new Date(deadline.getTime() - (2 * 60 * 60 * 1000))); // Bắt đầu trước 2 tiếng
      const now = formatICSDate(new Date());

      const icsContent = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//TYT Mo Duc//Quan Ly Cong Viec//VI',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH',
        'BEGIN:VEVENT',
        `UID:${t.tempId}@tytmoduc.quangngai.gov.vn`,
        `DTSTAMP:${now}`,
        `DTSTART:${dtStart}`,
        `DTEND:${dtEnd}`,
        `SUMMARY:[HẠN CHÓT] ${t.title}`,
        `DESCRIPTION:Yêu cầu kết quả: ${t.desc || 'Hoàn tất đúng hạn'}\\nCán bộ thực hiện: ${t.staff}\\nNgười giao việc: ${t.assigner}`,
        `LOCATION:Trạm Y Tế Xã Mộ Đức`,
        'STATUS:CONFIRMED',
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Han_chot_${t.title.slice(0, 25).replace(/[^a-zA-Z0-9\p{L}]/gu, '_')}.ics`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);

      showToast('Đã tải file lịch (.ics)! Bạn hãy mở file để thêm vào lịch điện thoại.', 'success');
    }

    function shareTaskViaZalo(tempId) {
      const allTasks = [...(window.__ACTIVE_TASKS || []), ...(window.__ARCHIVED_TASKS || [])];
      const t = allTasks.find(x => x.tempId === tempId);
      if (!t) return;

      const textToShare = `📌 [NHẮC VIỆC & NHIỆM VỤ Y TẾ]\n🎯 Nhiệm vụ: ${t.title}\n⏰ Hạn chót: ${formatDateTimeDisplay(t.deadline)}\n📋 Yêu cầu: ${t.desc || 'Theo chỉ đạo chuyên môn'}\n👥 Cán bộ thực hiện: ${t.staff}\n👤 Người chỉ đạo: ${t.assigner || 'BS. Phạm Minh Đức'}`;

      const textarea = document.createElement('textarea');
      textarea.value = textToShare;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);

      showToast('Đã sao chép nội dung tóm tắt! Bạn hãy dán vào Zalo để gửi cho đồng nghiệp.', 'info');
    }

    async function fetchTasksFromCloud(isAuto = false) {
      if (!GOOGLE_SHEET_TASKS_URL) return;

      if (!isAuto) showLoading('Đang đồng bộ công việc mới nhất từ Google Sheets...');
      try {
        const url = GOOGLE_SHEET_TASKS_URL + (GOOGLE_SHEET_TASKS_URL.includes('?') ? '&' : '?') + `action=loadTasks&t=${Date.now()}`;
        const response = await fetch(url, { method: 'GET', cache: 'no-store' });
        const rawText = await response.text();
        let res;
        try {
          res = JSON.parse(rawText);
        } catch (e) {
          console.warn("Phản hồi không phải JSON:", rawText);
          return;
        }

        if (res.status === 'success' && res.data && res.data.length > 0) {
          tasksList = res.data.map(item => ({
            ...item,
            tempId: item.tempId || `task_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`
          }));
          localStorage.setItem('TYT_TASKS_DATA', JSON.stringify(tasksList));
          processTasksData();
          if (!isAuto) showToast(`Đã đồng bộ thành công ${tasksList.length} công việc từ Google Sheets!`, 'success');
        } else {
          if (!isAuto) showToast('Dữ liệu công việc trên máy đang là mới nhất.', 'info');
        }
      } catch (err) {
        console.warn('Lỗi kết nối Google Sheets:', err);
        if (!isAuto) showToast('Không thể kết nối đến máy chủ. Đang hiển thị dữ liệu đã lưu trên máy.', 'warning');
      } finally {
        if (!isAuto) hideLoading();
      }
    }

    function showLoading(text) {
      document.getElementById('loading-text').innerText = text;
      document.getElementById('loading-overlay').style.display = 'flex';
    }

    function hideLoading() {
      document.getElementById('loading-overlay').style.display = 'none';
    }

    function showToast(msg, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');

      const colors = {
        success: 'bg-emerald-600 text-white shadow-emerald-600/30',
        error: 'bg-rose-600 text-white shadow-rose-600/30',
        warning: 'bg-amber-500 text-white shadow-amber-500/30',
        info: 'bg-slate-800 text-white shadow-slate-800/30'
      };

      const icons = {
        success: 'fa-circle-check',
        error: 'fa-circle-xmark',
        warning: 'fa-triangle-exclamation',
        info: 'fa-circle-info'
      };

      toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2.5 text-xs font-bold transition-all duration-300 transform translate-y-2 opacity-0 ${colors[type] || colors.info}`;
      toast.innerHTML = `<i class="fa-solid ${icons[type] || icons.info}"></i> <span>${msg}</span>`;

      container.appendChild(toast);
      requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
      setTimeout(() => {
        toast.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => toast.remove(), 3500);
      }, 3500);
    }
  </script>
