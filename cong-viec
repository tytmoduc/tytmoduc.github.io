<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Công Việc & Nhiệm Vụ Được Giao - Trạm Y Tế Xã Mộ Đức</title>

  <!-- Tailwind CSS & FontAwesome & Google Fonts -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=Times+New+Roman&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #f8fafc;
    }
    
    .font-times {
      font-family: 'Times New Roman', Times, serif;
    }

    /* Thanh cuộn mềm mại */
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

    #loading-overlay { display: none; }
    .loader {
      border: 4px solid #f1f5f9; border-top: 4px solid #0284c7;
      border-radius: 50%; width: 40px; height: 40px;
      animation: spin 1s linear infinite;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    /* Mô phỏng khổ A4 chuẩn thể thức văn bản hành chính Nghị định 30/2020 */
    .a4-simulation-sheet {
      width: 210mm;
      min-height: 297mm;
      padding: 20mm 15mm 20mm 25mm; /* Trái 25mm, phải 15mm, trên 20mm, dưới 20mm */
      margin: 0 auto;
      background: white;
      box-shadow: 0 10px 30px -10px rgba(0,0,0,0.15), 0 4px 6px -2px rgba(0,0,0,0.05);
      box-sizing: border-box;
      position: relative;
    }

    @media print {
      body {
        background-color: white !important;
        margin: 0 !important;
        padding: 0 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      
      body > *:not(#print-assignment-container) { display: none !important; }

      #print-assignment-container {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        font-family: 'Times New Roman', Times, serif;
        color: black;
        line-height: 1.45;
      }
    }
    #print-assignment-container { display: none; }
  </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col bg-slate-50 antialiased selection:bg-sky-100 selection:text-sky-900">

  <!-- OVERLAY LOADING -->
  <div id="loading-overlay" class="fixed inset-0 bg-white/85 backdrop-blur-sm z-50 flex flex-col items-center justify-center">
    <div class="loader mb-3.5"></div>
    <p class="text-sky-700 font-bold text-sm" id="loading-text">Đang đồng bộ danh mục nhiệm vụ từ Google Sheets...</p>
  </div>

  <!-- TOAST THÔNG BÁO -->
  <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- HEADER DÀNH CHO CÁN BỘ & NHÂN VIÊN -->
  <header class="flex-none p-3 md:p-5 pb-2">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-3.5 md:p-4 mb-3 flex flex-col md:flex-row justify-between items-start md:items-center gap-3 border-l-4 border-l-sky-600">
      
      <!-- Thông tin đơn vị & Tiêu đề -->
      <div class="flex items-center gap-3">
        <a href="index.html" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-sky-50 text-slate-600 hover:text-sky-700 flex items-center justify-center transition shrink-0" title="Về trang chủ">
          <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-lg sm:text-xl md:text-2xl font-black text-slate-900 tracking-tight flex items-center">
              <i class="fa-solid fa-list-check text-sky-600 mr-2"></i>Công Việc & Nhiệm Vụ Được Giao
            </h1>
            <span class="bg-sky-100 text-sky-900 text-[11px] px-2.5 py-0.5 rounded-full font-bold border border-sky-300">Dành Cho Cán Bộ</span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Tra cứu nhiệm vụ chuyên môn • Hạn chót sắp xếp gần nhất • Tự động ẩn việc đã xong • Xem & Tải Phiếu Giao Việc A4</p>
        </div>
      </div>

      <!-- CÁC NÚT THAO TÁC TIỆN ÍCH -->
      <div class="flex flex-wrap items-center gap-2 self-end md:self-auto">
        <button onclick="fetchTasksFromCloud(false)" class="px-3 py-2 bg-slate-100 hover:bg-sky-50 text-slate-700 hover:text-sky-800 border border-slate-200 rounded-xl font-bold transition text-xs flex items-center gap-1.5 shadow-xs" title="Làm mới dữ liệu từ Google Sheets">
          <i class="fa-solid fa-arrows-rotate text-sky-600"></i>
          <span>Cập nhật mới</span>
        </button>

        <a href="quan-ly-cong-viec.html" class="px-3.5 py-2 bg-sky-600 hover:bg-sky-700 text-white font-bold rounded-xl transition text-xs flex items-center gap-1.5 shadow-sm shadow-sky-600/30" title="Chuyển sang phân hệ Quản lý & Giao việc">
          <i class="fa-solid fa-sliders"></i>
          <span class="hidden sm:inline">Phân hệ Quản lý</span>
        </a>
      </div>
    </div>

    <!-- THANH TRA CỨU CÁ NHÂN: "TÌM NHIỆM VỤ CỦA TÔI" -->
    <div class="bg-gradient-to-r from-sky-600 to-sky-700 text-white rounded-2xl p-3 md:p-4 mb-3 shadow-sm flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-white/20 text-white flex items-center justify-center text-lg shrink-0 backdrop-blur-xs">
          <i class="fa-solid fa-user-check"></i>
        </div>
        <div>
          <div class="font-black text-sm md:text-base leading-tight">Tra Cứu Nhanh Nhiệm Vụ Của Tôi</div>
          <p class="text-[11.5px] text-sky-100 mt-0.5">Chọn tên của bạn để chỉ hiển thị các công việc, chỉ tiêu chuyên môn được phân công phụ trách</p>
        </div>
      </div>

      <!-- Ô chọn tên cán bộ từ danh bạ 29 người thuộc 4 điểm trạm -->
      <div class="flex items-center gap-2 bg-white/10 backdrop-blur-md p-1.5 rounded-xl border border-white/20">
        <label for="personal-staff-select" class="text-xs font-bold whitespace-nowrap pl-2 text-sky-100 flex items-center gap-1">
          <i class="fa-solid fa-id-card-clip text-sky-300"></i>
          <span>Cán bộ:</span>
        </label>
        <select id="personal-staff-select" onchange="onPersonalStaffFilterChange(this.value)" class="bg-white text-slate-900 border-none rounded-lg px-3 py-1.5 text-xs font-bold outline-none cursor-pointer shadow-xs max-w-[220px] sm:max-w-[260px] truncate">
          <option value="all">-- Xem tất cả cán bộ --</option>
          <!-- Nạp động bằng JavaScript -->
        </select>
        <button onclick="resetPersonalFilter()" id="btn-reset-personal" class="hidden px-2 py-1 bg-white/20 hover:bg-white/30 text-white rounded-lg text-xs font-bold transition" title="Xóa lọc cá nhân">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>

    <!-- THẺ THỐNG KÊ NHANH 4 CHỈ SỐ -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mb-2.5">
      
      <div class="bg-white p-3 rounded-2xl border border-rose-200 bg-gradient-to-r from-rose-50/70 to-white shadow-xs flex items-center justify-between">
        <div>
          <div class="text-[10.5px] font-bold text-rose-600 uppercase tracking-wide">Hạn Hôm Nay / Khẩn</div>
          <div class="text-xl font-black text-rose-700 mt-0.5" id="stat-count-today">0</div>
          <div class="text-[10px] text-rose-500 font-semibold">Cần giải quyết ngay trong ngày</div>
        </div>
        <div class="w-9 h-9 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-sm font-bold">
          <i class="fa-solid fa-fire animate-bounce"></i>
        </div>
      </div>

      <div class="bg-white p-3 rounded-2xl border border-amber-200 bg-gradient-to-r from-amber-50/70 to-white shadow-xs flex items-center justify-between">
        <div>
          <div class="text-[10.5px] font-bold text-amber-700 uppercase tracking-wide">Hạn Ngày Mai / 1-2 Ngày</div>
          <div class="text-xl font-black text-amber-800 mt-0.5" id="stat-count-tomorrow">0</div>
          <div class="text-[10px] text-amber-600 font-semibold">Cần đôn đốc hoàn tất sớm</div>
        </div>
        <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-sm font-bold">
          <i class="fa-solid fa-stopwatch"></i>
        </div>
      </div>

      <div class="bg-white p-3 rounded-2xl border border-sky-200 bg-gradient-to-r from-sky-50/70 to-white shadow-xs flex items-center justify-between">
        <div>
          <div class="text-[10.5px] font-bold text-sky-700 uppercase tracking-wide">Hạn Trong Tuần Này</div>
          <div class="text-xl font-black text-sky-800 mt-0.5" id="stat-count-week">0</div>
          <div class="text-[10px] text-sky-600 font-semibold">Kế hoạch công tác tuần</div>
        </div>
        <div class="w-9 h-9 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center text-sm font-bold">
          <i class="fa-solid fa-calendar-check"></i>
        </div>
      </div>

      <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-xs flex items-center justify-between">
        <div>
          <div class="text-[10.5px] font-bold text-slate-500 uppercase tracking-wide">Tổng Việc Đang Chạy</div>
          <div class="text-xl font-black text-slate-800 mt-0.5" id="stat-count-total">0</div>
          <div class="text-[10px] text-emerald-600 font-semibold" id="stat-hidden-past">Đã tự động ẩn việc cũ</div>
        </div>
        <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center text-sm font-bold">
          <i class="fa-solid fa-briefcase"></i>
        </div>
      </div>

    </div>

    <!-- BỘ LỌC DANH MỤC & THỜI GIAN & Ô TÌM KIẾM -->
    <div class="flex flex-col lg:flex-row justify-between items-stretch lg:items-center gap-2 mb-1">
      
      <div class="flex flex-wrap items-center gap-1.5">
        
        <!-- Lọc theo tính chất / mức độ ưu tiên -->
        <div class="flex items-center gap-1 bg-white p-1 rounded-xl border border-slate-200 shadow-xs overflow-x-auto custom-scrollbar">
          <button onclick="filterByPriority('all')" id="btn-prio-all" class="px-2.5 py-1 rounded-lg text-xs font-bold transition bg-sky-600 text-white shadow-xs whitespace-nowrap">
            Tất cả việc (<span id="count-prio-all">0</span>)
          </button>
          <button onclick="filterByPriority('urgent')" id="btn-prio-urgent" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition whitespace-nowrap flex items-center gap-1">
            <i class="fa-solid fa-bolt text-rose-500"></i> Khẩn cấp / Trọng tâm (<span id="count-prio-urgent">0</span>)
          </button>
          <button onclick="filterByPriority('normal')" id="btn-prio-normal" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition whitespace-nowrap flex items-center gap-1">
            <i class="fa-solid fa-clipboard-check text-sky-600"></i> Định kỳ (<span id="count-prio-normal">0</span>)
          </button>
          <button onclick="filterByPriority('followup')" id="btn-prio-followup" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition whitespace-nowrap flex items-center gap-1">
            <i class="fa-solid fa-eye text-teal-600"></i> Phối hợp (<span id="count-prio-followup">0</span>)
          </button>
        </div>

        <!-- Lọc theo thời hạn -->
        <div class="flex items-center gap-1 bg-white p-1 rounded-xl border border-slate-200 shadow-xs">
          <button onclick="filterByTime('all')" id="btn-time-all" class="px-2 py-1 rounded-lg text-xs font-bold bg-slate-700 text-white transition">Tất cả hạn</button>
          <button onclick="filterByTime('urgent')" id="btn-time-urgent" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition">Hôm nay / Mai</button>
          <button onclick="filterByTime('week')" id="btn-time-week" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition">Tuần này</button>
          <button onclick="filterByTime('month')" id="btn-time-month" class="px-2 py-1 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition">Trong tháng</button>
        </div>

      </div>

      <!-- Ô tìm kiếm công việc thông minh -->
      <div class="flex items-center gap-2 bg-white px-3 py-1.5 rounded-xl border border-slate-200 shadow-xs flex-1 lg:max-w-xs">
        <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs"></i>
        <input type="text" id="search-task-input" placeholder="Tìm tên nhiệm vụ, chỉ đạo, cán bộ..." class="w-full bg-transparent border-none outline-none text-xs text-slate-700 focus:ring-0" onkeyup="renderTasksList()">
      </div>

    </div>
  </header>

  <!-- NỘI DUNG CHÍNH: DANH SÁCH NHIỆM VỤ SẮP TỚI & KHO LƯU TRỮ -->
  <main class="flex-1 overflow-hidden p-3 md:p-5 pt-0 flex flex-col">
    
    <div class="flex-1 flex flex-col overflow-hidden space-y-3">
      
      <!-- Thông báo lọc cá nhân nếu có -->
      <div id="personal-filter-notice" class="hidden bg-sky-50 border border-sky-200 p-2.5 rounded-xl flex items-center justify-between text-xs font-bold text-sky-900">
        <div class="flex items-center gap-2">
          <span class="w-6 h-6 rounded-lg bg-sky-600 text-white flex items-center justify-center text-xs">
            <i class="fa-solid fa-user"></i>
          </span>
          <span>Đang hiển thị nhiệm vụ của cán bộ: <b id="personal-filter-name" class="text-sky-800 text-sm">---</b></span>
          <span class="text-slate-400 font-normal">• (<span id="personal-filter-count">0</span> công việc)</span>
        </div>
        <button onclick="resetPersonalFilter()" class="px-2.5 py-1 bg-white hover:bg-sky-100 text-sky-800 border border-sky-300 rounded-lg text-xs font-bold transition">
          Xem tất cả cán bộ
        </button>
      </div>

      <!-- Khung danh sách thẻ công việc -->
      <div class="flex-1 overflow-y-auto custom-scrollbar pr-1 space-y-2.5" id="tasks-list-container">
        <!-- Render sống động qua JavaScript -->
      </div>

      <!-- Khu vực công việc đã hoàn thành hoặc hết hạn (Tự động ẩn) -->
      <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-xs flex flex-col sm:flex-row justify-between items-center gap-2 text-xs">
        <div class="text-slate-500 font-medium flex items-center gap-1.5">
          <i class="fa-solid fa-shield-halved text-emerald-600"></i>
          <span>Các công việc đã qua hạn chót hoặc hoàn thành được tự động đưa vào kho lưu trữ để bạn không bị xao nhãng.</span>
        </div>
        <button onclick="toggleArchivedTasks()" id="btn-toggle-archive" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold transition flex items-center gap-1.5">
          <i class="fa-solid fa-clock-rotate-left text-slate-500"></i>
          <span>Xem việc đã kết thúc / hết hạn (<span id="count-archived-num">0</span>)</span>
        </button>
      </div>

      <!-- Danh sách việc đã kết thúc / hết hạn (Mặc định ẩn) -->
      <div id="archived-tasks-container" class="hidden max-h-48 overflow-y-auto custom-scrollbar space-y-2 p-3 bg-slate-100 rounded-2xl border border-slate-200 text-xs">
        <!-- Render qua JS khi người dùng cần xem -->
      </div>
    </div>

  </main>

  <!-- MODAL XEM TRƯỚC PHIẾU GIAO NHIỆM VỤ A4 (CHUẨN NGHỊ ĐỊNH 30) -->
  <div id="doc-preview-modal" class="fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-2 sm:p-4 overflow-y-auto">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl border border-slate-200 overflow-hidden my-auto flex flex-col max-h-[92vh]">
      
      <!-- Header Modal -->
      <div class="p-3.5 bg-slate-900 text-white flex justify-between items-center flex-none">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-sky-500 text-slate-950 flex items-center justify-center font-black">
            <i class="fa-solid fa-file-contract"></i>
          </div>
          <div>
            <h3 class="font-extrabold text-sm sm:text-base leading-tight">Phiếu Giao Nhiệm Vụ & Phân Công Công Việc</h3>
            <p class="text-[11px] text-slate-300">Thể thức hành chính Nghị định 30/2020/NĐ-CP • Khổ A4 Dọc • Phông chữ Times New Roman</p>
          </div>
        </div>
        <button onclick="closeDocPreviewModal()" class="w-8 h-8 rounded-lg hover:bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center transition">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      </div>

      <!-- Khung xem trước mặt giấy A4 -->
      <div class="flex-1 bg-slate-200/90 p-3 sm:p-6 overflow-y-auto custom-scrollbar flex justify-center">
        <article id="modal-a4-paper" class="a4-simulation-sheet font-times text-black text-[13pt] leading-[1.4] select-text shadow-xl">
          <!-- Render động qua JavaScript -->
        </article>
      </div>

      <!-- Footer Modal: Tải Word & In PDF -->
      <div class="p-3 bg-slate-50 border-t border-slate-200 flex flex-wrap gap-2 justify-between items-center flex-none text-xs">
        <div class="text-[11.5px] text-slate-500 hidden sm:flex items-center gap-1.5 font-medium">
          <i class="fa-solid fa-circle-check text-emerald-600"></i>
          <span>Bạn có thể tải file Word (.doc) hoặc In PDF để lưu trữ hồ sơ công việc hoặc trình ký.</span>
        </div>
        <div class="flex items-center gap-2 ml-auto">
          <button type="button" onclick="closeDocPreviewModal()" class="px-3 py-1.5 rounded-xl font-bold text-slate-600 hover:bg-slate-200 transition">
            Đóng
          </button>
          <button type="button" onclick="copyCurrentDocText()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold transition flex items-center gap-1">
            <i class="fa-solid fa-copy"></i> Sao chép
          </button>
          <button type="button" onclick="downloadCurrentWordDoc()" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold transition shadow-sm flex items-center gap-1.5">
            <i class="fa-solid fa-file-word"></i> Tải File Word (.doc)
          </button>
          <button type="button" onclick="printCurrentAssignmentDoc()" class="px-3.5 py-1.5 bg-sky-600 hover:bg-sky-700 text-white rounded-xl font-bold transition shadow-sm shadow-sky-600/30 flex items-center gap-1.5">
            <i class="fa-solid fa-print"></i> In Phiếu A4 (PDF)
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- KHUNG IN VĂN BẢN A4 CHO TRÌNH DUYỆT -->
  <div id="print-assignment-container" class="w-full text-black font-times">
    <!-- Render động khi in -->
  </div>

  <script>
    // URL GOOGLE APPS SCRIPT WEB APP MẶC ĐỊNH MỚI CHO QUẢN LÝ CÔNG VIỆC
    const DEFAULT_GOOGLE_SHEET_TASKS_URL = "https://script.google.com/macros/s/AKfycbzm7GcXOJnmCzFvp1WHy1TCex45KocdorP2wYkizmXnOffD4mwBPq3HAse3ak-4ibsS/exec";
    
    // Tự động nâng cấp URL trong localStorage nếu đang để trống hoặc dùng URL cũ
    const savedTasksApiUrl = localStorage.getItem('TYT_TASKS_API_URL');
    let GOOGLE_SHEET_TASKS_URL = DEFAULT_GOOGLE_SHEET_TASKS_URL;
    if (savedTasksApiUrl && savedTasksApiUrl.trim() !== "") {
      GOOGLE_SHEET_TASKS_URL = savedTasksApiUrl;
    } else {
      localStorage.setItem('TYT_TASKS_API_URL', DEFAULT_GOOGLE_SHEET_TASKS_URL);
      GOOGLE_SHEET_TASKS_URL = DEFAULT_GOOGLE_SHEET_TASKS_URL;
    }

    // 29 cán bộ theo 4 điểm trạm chuẩn xác
    const DEFAULT_STAFF_29 = [
      // 1. Đức Tân - 10 cán bộ
      { name: "Trần Thị Lệ Thy", shortName: "NHS Thy", point: "Điểm trạm chính (Đức Tân)" },
      { name: "Trịnh Thị Minh Tuệ", shortName: "Ys Tuệ", point: "Điểm trạm chính (Đức Tân)" },
      { name: "Huỳnh Thị Thuỳ Yên", shortName: "DS Yên", point: "Điểm trạm chính (Đức Tân)" },
