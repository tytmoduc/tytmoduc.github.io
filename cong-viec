      const stored = localStorage.getItem('TYT_STAFF_LIST');
      if (stored) {
        try {
          const parsed = JSON.parse(stored);
          const active = parsed.filter(s => s.status !== 'inactive');
          if (active.length > 0) {
            return active.map(item => ({
              name: item.name,
              shortName: item.shortName || item.name,
              point: item.point || 'Điểm trạm chính'
            }));
          }
        } catch(e) {}
      }
      return DEFAULT_STAFF_29;
    }

