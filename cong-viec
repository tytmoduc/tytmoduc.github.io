    function parseTaskDeadline(item) {
      let deadline = null;
      if (item.deadlineIso) {
        deadline = new Date(item.deadlineIso);
      }
      if (!deadline || isNaN(deadline.getTime())) {
        deadline = new Date(2099, 0, 1);
      }
      return deadline;
    }

    function formatDateTimeDisplay(date) {
      if (!date || isNaN(date.getTime())) return '';
      const days = ['Chủ Nhật', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];
      const dayOfWeek = days[date.getDay()];
      const d = String(date.getDate()).padStart(2, '0');
      const m = String(date.getMonth() + 1).padStart(2, '0');
      const y = date.getFullYear();
      const hh = String(date.getHours()).padStart(2, '0');
      const mm = String(date.getMinutes()).padStart(2, '0');
      return `${dayOfWeek} (${d}/${m}/${y}) - ${hh}:${mm}`;
    }

    function processTasksData() {
      const now = new Date();
      const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);

      const parsed = tasksList.map((item, idx) => {
        const deadline = parseTaskDeadline(item);
        const isExpired = deadline.getTime() < now.getTime();
        const diffMs = deadline.getTime() - todayStart.getTime();
        const diffDays = Math.floor(diffMs / (24 * 60 * 60 * 1000));

        let level = 5;
        let levelBadge = '';
        let levelText = '';
        let colorTheme = {};

        if (isExpired) {
          level = 0;
        } else if (diffDays <= 0) {
          level = 1;
          levelBadge = 'bg-rose-600 text-white animate-pulse';
          levelText = '🔴 HẠN HÔM NAY';
          colorTheme = {
            cardBorder: 'border-l-[6px] border-l-rose-600 border-rose-200 bg-gradient-to-r from-rose-50/80 to-white',
            badgeBg: 'bg-rose-100 text-rose-800 border border-rose-300',
            dateBox: 'bg-rose-600 text-white',
            tag: 'Hôm nay'
          };
        } else if (diffDays === 1 || diffDays === 2) {
          level = 2;
          levelBadge = 'bg-amber-500 text-white';
          levelText = diffDays === 1 ? '🟠 HẠN NGÀY MAI' : '🟠 CÒN 2 NGÀY';
          colorTheme = {
            cardBorder: 'border-l-[6px] border-l-amber-500 border-amber-200 bg-gradient-to-r from-amber-50/70 to-white',
            badgeBg: 'bg-amber-100 text-amber-900 border border-amber-300',
            dateBox: 'bg-amber-500 text-white',
            tag: diffDays === 1 ? 'Ngày mai' : 'Còn 2 ngày'
          };
        } else if (diffDays <= 7) {
          level = 3;
          levelBadge = 'bg-sky-600 text-white';
          levelText = `🔵 CÒN ${diffDays} NGÀY (Tuần này)`;
          colorTheme = {
            cardBorder: 'border-l-[6px] border-l-sky-500 border-sky-200 bg-gradient-to-r from-sky-50/60 to-white',
            badgeBg: 'bg-sky-100 text-sky-900 border border-sky-300',
            dateBox: 'bg-sky-600 text-white',
            tag: `Còn ${diffDays} ngày`
          };
        } else if (diffDays <= 14) {
          level = 4;
          levelBadge = 'bg-teal-600 text-white';
          levelText = `🟢 CÒN ${diffDays} NGÀY (Tuần tới)`;
          colorTheme = {
            cardBorder: 'border-l-[6px] border-l-teal-500 border-teal-200 bg-gradient-to-r from-teal-50/50 to-white',
            badgeBg: 'bg-teal-100 text-teal-900 border border-teal-300',
            dateBox: 'bg-teal-600 text-white',
            tag: `Còn ${diffDays} ngày`
          };
        } else {
          level = 5;
          levelBadge = 'bg-slate-500 text-white';
          levelText = `⚪ CÒN ${diffDays} NGÀY`;
          colorTheme = {
            cardBorder: 'border-l-[6px] border-l-slate-400 border-slate-200 bg-white',
            badgeBg: 'bg-slate-100 text-slate-700 border border-slate-300',
            dateBox: 'bg-slate-700 text-white',
            tag: `Còn ${diffDays} ngày`
          };
        }

        return {
          ...item,
          tempId: item.tempId || `task_${idx}_${Date.now()}`,
          deadline,
          diffDays,
          isExpired,
          level,
          levelBadge,
          levelText,
          colorTheme
        };
      });

      // TỰ ĐỘNG BỎ QUA CÔNG VIỆC HẾT HẠN HOẶC ĐÃ HOÀN THÀNH
      const activeUpcoming = parsed.filter(t => !t.isExpired && t.status !== 'Đã hoàn thành');
      const archivedPast = parsed.filter(t => t.isExpired || t.status === 'Đã hoàn thành');

      // SẮP XẾP HẠN CHÓT GẦN NHẤT ĐẦU TIÊN
      activeUpcoming.sort((a, b) => a.deadline.getTime() - b.deadline.getTime());
      archivedPast.sort((a, b) => b.deadline.getTime() - a.deadline.getTime());

      window.__ACTIVE_TASKS = activeUpcoming;
      window.__ARCHIVED_TASKS = archivedPast;

      updateStatistics();
      renderTasksList();
      renderArchivedTasksList();
    }

    function updateStatistics() {
      const active = window.__ACTIVE_TASKS || [];
      const archived = window.__ARCHIVED_TASKS || [];

      const todayCount = active.filter(t => t.diffDays <= 0).length;
      const tomorrowCount = active.filter(t => t.diffDays === 1 || t.diffDays === 2).length;
      const weekCount = active.filter(t => t.diffDays <= 7).length;

      document.getElementById('stat-count-today').innerText = todayCount;
      document.getElementById('stat-count-tomorrow').innerText = tomorrowCount;
      document.getElementById('stat-count-week').innerText = weekCount;
      document.getElementById('stat-count-total').innerText = active.length;
      document.getElementById('stat-hidden-past').innerText = `Đã ẩn ${archived.length} việc cũ/xong`;

      const urgentCount = active.filter(t => t.priority === 'urgent').length;
      const normalCount = active.filter(t => t.priority === 'normal').length;
      const followupCount = active.filter(t => t.priority === 'followup').length;

      document.getElementById('count-prio-all').innerText = active.length;
      document.getElementById('count-prio-urgent').innerText = urgentCount;
      document.getElementById('count-prio-normal').innerText = normalCount;
      document.getElementById('count-prio-followup').innerText = followupCount;

      document.getElementById('count-archived-num').innerText = archived.length;
    }

