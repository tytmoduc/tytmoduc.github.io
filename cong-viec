      activePreviewTask = t;
      const modalPaper = document.getElementById('modal-a4-paper');
      modalPaper.innerHTML = buildAssignmentDocHtml(t);

      document.getElementById('doc-preview-modal').classList.remove('hidden');
    }

    function closeDocPreviewModal() {
      document.getElementById('doc-preview-modal').classList.add('hidden');
      activePreviewTask = null;
    }

