    function handleSaveTaskSubmit(e) {
      e.preventDefault();

      const editId = document.getElementById('form-task-id').value;
      const title = document.getElementById('form-task-title').value.trim();
      const desc = document.getElementById('form-task-desc').value.trim();
      const assigner = document.getElementById('form-task-assigner').value.trim() || 'BS. Phạm Minh Đức (Giám đốc)';
      const status = document.getElementById('form-task-status').value;

      let priority = 'normal';
      const radios = document.getElementsByName('form-task-priority');
      for (const r of radios) {
        if (r.checked) priority = r.value;
      }

      const staff = formSelectedStaff.join(', ');
      const dDate = document.getElementById('form-deadline-date').value;
      const dTime = document.getElementById('form-deadline-time').value || '17:00';

      if (!title || !dDate || formSelectedStaff.length === 0) {
        showToast('Vui lòng điền đủ Tên công việc, Cán bộ thực hiện và Ngày hết hạn!', 'warning');
        return;
      }

      const deadlineIso = `${dDate}T${dTime}:00`;

      if (editId) {
        const target = tasksList.find(t => t.tempId === editId);
        if (target) {
          target.title = title;
          target.desc = desc;
          target.staff = staff;
          target.assigner = assigner;
          target.priority = priority;
          target.status = status;
          target.deadlineIso = deadlineIso;
          showToast('Đã cập nhật công việc thành công!', 'success');
        }
      } else {
        const newTask = {
          tempId: `task_${Date.now()}`,
          title,
          desc,
          staff,
          assigner,
          priority,
          status,
          deadlineIso
        };
        tasksList.unshift(newTask);
        showToast('Đã giao nhiệm vụ mới thành công!', 'success');
      }

      saveTasksToStorage();
      closeTaskModal();
      processTasksData();
    }

    function handleEditTask(tempId) {
      const item = (window.__ACTIVE_TASKS || []).find(t => t.tempId === tempId) ||
                   (window.__ARCHIVED_TASKS || []).find(t => t.tempId === tempId);
      if (item) {
        openTaskModal(item);
      }
    }

    function handleDeleteTask(tempId) {
      const item = (window.__ACTIVE_TASKS || []).find(t => t.tempId === tempId) ||
                   (window.__ARCHIVED_TASKS || []).find(t => t.tempId === tempId);
      if (!item) return;

      showConfirmModal(
        'Xác nhận xóa nhiệm vụ',
        `Bạn có chắc chắn muốn xóa công việc:\n"${item.title}"?`,
        () => {
          tasksList = tasksList.filter(t => t.tempId !== tempId);
          saveTasksToStorage();
          processTasksData();
          showToast('Đã xóa công việc thành công!', 'info');
