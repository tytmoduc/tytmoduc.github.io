    function renderStaffDirectoryItems() {
      const container = document.getElementById('staff-directory-list-container');
      const search = (document.getElementById('staff-search-input')?.value || '').toLowerCase().trim();
      const staffList = getLiveStaffList();

      const filtered = staffList.filter(s => 
        s.name.toLowerCase().includes(search) || 
        (s.shortName && s.shortName.toLowerCase().includes(search)) ||
        (s.point && s.point.toLowerCase().includes(search))
      );

      const groups = {};
      filtered.forEach(s => {
        if (!groups[s.point]) groups[s.point] = [];
        groups[s.point].push(s);
      });

      let html = '';
      for (const pt in groups) {
        html += `
          <div class="space-y-1">
            <div class="text-[10.5px] font-black uppercase tracking-wider text-slate-500 bg-slate-100 px-2 py-1 rounded-lg">
              ${pt} (${groups[pt].length})
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-1">
              ${groups[pt].map(stf => {
                const isSelected = formSelectedStaff.includes(stf.name);
                return `
                  <div onclick="toggleSelectStaff('${stf.name.replace(/'/g, "\\'")}')" class="p-2 rounded-xl border flex items-center justify-between cursor-pointer transition ${
                    isSelected ? 'bg-sky-50 border-sky-300 text-sky-900 font-bold' : 'bg-white border-slate-200 text-slate-700 hover:bg-slate-50'
                  }">
                    <div class="flex items-center gap-1.5 truncate">
                      <span class="w-2 h-2 rounded-full ${isSelected ? 'bg-sky-600' : 'bg-slate-300'}"></span>
                      <span class="truncate">${stf.name}</span>
                    </div>
                    <span class="text-[10px] font-bold text-sky-700 bg-sky-100/70 px-1.5 py-0.2 rounded">
                      ${stf.shortName || 'CB'}
                    </span>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }

      container.innerHTML = html;
      document.getElementById('modal-selected-count').innerText = formSelectedStaff.length;
    }

