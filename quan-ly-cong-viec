      XLSX.writeFile(wb, `QuanLy_CongViec_TYTMoDuc_${Date.now()}.xlsx`);
    }

    function openApiConfigModal() {
      document.getElementById('cloud-api-url-input').value = GOOGLE_SHEET_TASKS_URL;
      document.getElementById('api-config-modal').classList.remove('hidden');
    }

    function closeApiConfigModal() {
      document.getElementById('api-config-modal').classList.add('hidden');
    }

    function saveCloudApiUrl() {
      const url = document.getElementById('cloud-api-url-input').value.trim();
      GOOGLE_SHEET_TASKS_URL = url;
      localStorage.setItem('TYT_TASKS_API_URL', url);
      closeApiConfigModal();
      showToast('Đã lưu cấu hình Google Apps Script Cloud URL!', 'success');
      fetchTasksFromCloud();
    }

    async function saveTasksToCloud() {
      if (!GOOGLE_SHEET_TASKS_URL) {
        showToast("Vui lòng cấu hình URL Google Sheets trước!", "warning");
        openApiConfigModal();
        return;
      }

      showLoading("Đang lưu danh sách công việc & nhiệm vụ lên Google Sheets...");
      try {
        const payload = {
          action: "saveTasks",
          data: {
            records: tasksList.map(t => ({
              tempId: t.tempId || `task_${Date.now()}`,
              title: t.title || "",
              desc: t.desc || "",
              staff: t.staff || "",
              assigner: t.assigner || "BS. Phạm Minh Đức (Giám đốc)",
              priority: t.priority || "normal",
              status: t.status || "Đang tiến hành",
              deadlineIso: t.deadlineIso || ""
            }))
          }
        };

        const response = await fetch(GOOGLE_SHEET_TASKS_URL, {
          method: "POST",
          headers: { "Content-Type": "text/plain;charset=utf-8" },
          body: JSON.stringify(payload)
        });

        const rawText = await response.text();
        let res;
        try {
          res = JSON.parse(rawText);
        } catch(jsonErr) {
          console.warn("Phản hồi không phải JSON:", rawText);
          showToast("Đã gửi yêu cầu lưu lên Google Sheets!", "info");
          return;
        }

        if (res && res.status === "success") {
          showToast(res.message || "Đã lưu thành công công việc lên Google Sheets!", "success");
        } else {
          showToast("Lỗi lưu dữ liệu: " + (res.message || "Không xác định"), "error");
        }
      } catch (err) {
        console.error("Lỗi khi lưu lên Cloud:", err);
        showToast("Lỗi kết nối khi gửi dữ liệu lên Google Sheet.", "error");
      } finally {
        hideLoading();
      }
    }

    async function fetchTasksFromCloud(isAuto = false) {
      if (!GOOGLE_SHEET_TASKS_URL) {
        if (!isAuto) showToast('Chưa cấu hình Web App URL. Đang dùng dữ liệu cục bộ.', 'info');
        return;
      }

      if (!isAuto) showLoading('Đang đồng bộ công việc từ Google Sheets...');
      try {
        const url = GOOGLE_SHEET_TASKS_URL + (GOOGLE_SHEET_TASKS_URL.includes('?') ? '&' : '?') + `action=loadTasks&t=${Date.now()}`;
        const response = await fetch(url, { method: 'GET', cache: 'no-store' });
        const res = await response.json();

        if (res.status === 'success' && res.data && res.data.length > 0) {
          tasksList = res.data.map(item => ({
            ...item,
            tempId: item.tempId || `task_${Date.now()}_${Math.random().toString(36).slice(2, 6)}`
          }));
          saveTasksToStorage(false);
          processTasksData();
          if (!isAuto) showToast(`Đã đồng bộ thành công ${tasksList.length} công việc từ Google Sheets!`, 'success');
        } else {
          if (!isAuto) showToast('Không có dữ liệu công việc mới trên Google Sheets.', 'info');
        }
      } catch (err) {
        console.warn('Lỗi kết nối Google Sheets:', err);
        if (!isAuto) showToast('Không thể kết nối đến Google Sheets. Đang dùng dữ liệu trên máy.', 'warning');
      } finally {
        if (!isAuto) hideLoading();
      }
    }

    function showLoading(text) {
      document.getElementById('loading-text').innerText = text;
      document.getElementById('loading-overlay').style.display = 'flex';
    }

    function hideLoading() {
      document.getElementById('loading-overlay').style.display = 'none';
    }

    function showToast(msg, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');

      const colors = {
        success: 'bg-emerald-600 text-white shadow-emerald-600/30',
        error: 'bg-rose-600 text-white shadow-rose-600/30',
        warning: 'bg-amber-500 text-white shadow-amber-500/30',
        info: 'bg-slate-800 text-white shadow-slate-800/30'
      };

      const icons = {
        success: 'fa-circle-check',
        error: 'fa-circle-xmark',
        warning: 'fa-triangle-exclamation',
        info: 'fa-circle-info'
      };

      toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2.5 text-xs font-bold transition-all duration-300 transform translate-y-2 opacity-0 ${colors[type] || colors.info}`;
      toast.innerHTML = `<i class="fa-solid ${icons[type] || icons.info}"></i> <span>${msg}</span>`;

      container.appendChild(toast);
      requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
      setTimeout(() => {
        toast.classList.add('translate-y-2', 'opacity-0');
        setTimeout(() => toast.remove(), 3500);
      }, 3500);
    }

    function showConfirmModal(title, msg, onConfirm) {
      document.getElementById('confirm-modal-title').innerText = title;
      document.getElementById('confirm-modal-msg').innerText = msg;
      document.getElementById('confirm-modal').classList.remove('hidden');
      confirmCallback = onConfirm;
    }

    function closeConfirmModal(accepted) {
      document.getElementById('confirm-modal').classList.add('hidden');
      if (accepted && typeof confirmCallback === 'function') {
        confirmCallback();
      }
      confirmCallback = null;
    }
  </script>
